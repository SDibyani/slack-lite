
# =============================================
# Slack-lite Server Environment Variables
# =============================================
# Copy this file to `.env` and replace with your values.
# NEVER commit your actual .env file.

# Server
PORT=4000

# MongoDB Atlas connection string
# Create a cluster at https://cloud.mongodb.com and replace the placeholder
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/slack-lite?retryWrites=true&w=majority

# JWT signing secret — use a long random string in production
JWT_SECRET=replace_with_a_long_random_secret_string

# Frontend origin (used for CORS and Socket.IO)
CLIENT_URL=http://localhost:4200
